# Java Bot Configuration
# Copy this file to .env and update values for your environment
# The bot reads all its configuration from .env (which is git-ignored)

# Required: Portal/Laravel base URL where bot fetches config
# Used to construct config endpoint: {APP_URL}/api/config?gmail={BOT_CONFIG_GMAIL}
APP_URL=https://yourdomain.com

# Required: Email/Gmail used to fetch bot configuration from portal
# Bot identifies itself with this email when fetching config
BOT_CONFIG_GMAIL=your-email@example.com

# Optional: Direct config URL (overrides APP_URL + BOT_CONFIG_GMAIL if set)
# Example: https://yourdomain.com/api/config?gmail=your-email@example.com
# BOT_CONFIG_URL=https://yourdomain.com/api/config?gmail=your-email@example.com

# Optional: Captcha fetch endpoint (uses remote config default if not set)
# Remote config specifies the primary captcha URL
# Only override if you have a custom captcha service
# CAPTCHA_GET_URL=https://yourdomain.com/api/captcha/get

# Required by the portal's captcha API: sent as `Authorization: Bearer ...` when fetching a
# token. Leave it blank on a distributed worker — the client then falls back to SLOT_API_KEY,
# which the portal accepts for the same routes. A JAR that sends no credential at all gets 401
# from both /api/captcha/request and /api/captcha/get.
# CAPTCHA_API_TOKEN=your-captcha-api-token
