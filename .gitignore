# Claude Code local settings — machine-specific approved-command cache. It
# accumulates whatever gets approved, which has included live credentials
# (SSH passwords, API keys), so it must never be version-controlled.
/.claude/settings.local.json
/.claude/settings.local.json.tmp.*

# dg-epay checkout HAR captures — ~190MB and they hold live session cookies,
# wallet PINs and OTPs. Research artefacts, kept local only.
/tests/*.har
/tests/har-data/
