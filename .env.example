APP_NAME=DURONTO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ipms.senda.fit
SANCTUM_STATEFUL_DOMAINS=ipms.senda.fit
# Legacy token endpoint handed to bots through the config export. It now sits behind the captcha
# API credential, so a consumer must send `Authorization: Bearer ...` (CAPTCHA_API_TOKEN or its
# slot api_key); an older JAR that sends nothing gets 401 and needs a redeploy.
CAPTCHA_GET_URL=https://ipms.senda.fit/api/captcha/get

# Publish the repository APK during Railway bootstrap. Set false to manage APK releases only via the admin UI.
APK_SYNC_BUNDLED_RELEASE=true
APK_BUNDLED_VERSION=1.0.0
APK_BUNDLED_VERSION_CODE=1
APK_BUNDLED_FILE_NAME=DURONTO.apk
APK_BUNDLED_MIN_ANDROID=8.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ipms_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=ipms.senda.fit
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="your-domain.com"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback
GOOGLE_PUBSUB_TOPIC=

# Tokenhunter payment publish API
TOKENHUNTER_PUBLISH_URL=https://payment.tokenhunter.online/api/payment/publish
TOKENHUNTER_PUBLISH_TOKEN=

PAGE_PASSWORD=

# Cloudflare Turnstile — protects /login and /register from brute-force/spam.
# Create a widget for the domain at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared secret the bot and other machine callers send as `Authorization: Bearer ...`
# on POST/GET /api/captcha/request. Bots may send their slot api_key instead, so this
# is optional — but anonymous callers are refused either way.
CAPTCHA_API_TOKEN=

# Requests per minute one credential may make to the captcha delivery routes, and to the poll
# route. Delivery is where a leaked credential costs money; raise it if a worker drives many
# accounts at once.
CAPTCHA_API_RATE_LIMIT=240
CAPTCHA_POLL_RATE_LIMIT=7200
