{
    "manifest_version": 3,
    "name": "DURONTO IVAC Payment Helper",
    "version": "1.4",
    "description": "Captures the IVAC dg-epay payment callback (redirect) URL in your browser and forwards it to the DURONTO portal, so payment links are completed automatically.",
    "author": "DURONTO",
    "key": "",
    "permissions": ["tabs", "webNavigation", "declarativeNetRequest"],
    "host_permissions": [
        "https://api.ivacbd.com/*",
        "https://ipms.senda.fit/*",
        "https://ivacbd.up.railway.app/*"
    ],
    "externally_connectable": {
        "matches": [
            "https://ipms.senda.fit/*",
            "https://ivacbd.up.railway.app/*"
        ]
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "dgepay_redirect_rules",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    }
}
